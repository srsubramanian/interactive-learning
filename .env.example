# Copy this file to ".env" and fill in your keys.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-haiku-5-5        # reviews her spoken answers
# EXPLAIN_MODEL=claude-sonnet-5-5      # richer custom picture lessons (default: same as CLAUDE_MODEL)
# ELEVENLABS_VOICE_ID=                 # pick a specific voice; otherwise a friendly premade voice is chosen
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# STT_PROVIDER=elevenlabs              # or "browser" to listen with the browser (Chrome) instead of ElevenLabs
# PORT=3000
