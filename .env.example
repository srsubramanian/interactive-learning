# Copy this file to ".env" and fill in your keys.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Remove the leading "# " from a line to use it.

# Reviews her spoken answers.
# CLAUDE_MODEL=claude-haiku-5-5

# Richer custom picture lessons (default: same as CLAUDE_MODEL).
# EXPLAIN_MODEL=claude-sonnet-5-5

# Pick a specific voice; otherwise a friendly premade voice (Sarah) is chosen.
# ELEVENLABS_VOICE_ID=

# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# "elevenlabs" (default) or "browser" to listen with Chrome's recognizer instead.
# Note: with "browser", Chrome sends her audio to Google, not ElevenLabs.
# STT_PROVIDER=elevenlabs

# PORT=3000

# Extra host names allowed to reach the server, comma separated
# (localhost and Tailscale *.ts.net names are always allowed).
# ALLOWED_HOSTS=
